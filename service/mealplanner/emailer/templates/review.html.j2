<div style="font-family: Georgia, serif; max-width: 640px; margin: 0 auto; color: #2b2b2b;">
  <h1 style="font-size: 22px; border-bottom: 2px solid #c96f4a; padding-bottom: 8px;">
    How was last week?
  </h1>
  <p style="font-size: 14px; color: #555;">
    Tap a star on anything you have an opinion about — two good ratings makes a dish
    a regular, two poor ones retires it. Notes and replies work too, and everything
    you say here shapes next week's plan.
  </p>

  {% for m in meals %}
  <div style="border: 1px solid #ddd; border-radius: 6px; padding: 12px 14px; margin: 10px 0;">
    <strong>{% if m.url %}<a href="{{ m.url }}" style="color:#2b2b2b;">{{ m.title }}</a>{% else %}{{ m.title }}{% endif %}</strong>
    <span style="color:#777; font-size: 13px;">— {{ m.day }}{% if m.meal_type != 'dinner' %} ({{ m.meal_type }}){% endif %}</span>
    {% if m.source_label %}<br><span style="color:#999; font-size:12px;">from {% if m.source and m.source.startswith('http') %}<a href="{{ m.source }}" style="color:#999;">{{ m.source_label }}</a>{% else %}{{ m.source_label }}{% endif %}</span>{% endif %}
    {% if m.rated %}<br><span style="color:#777; font-size:12px;">already rated {{ m.current }} · {{ m.lifecycle }}</span>{% endif %}
    {% if m.stars %}
    <div style="margin-top: 6px;">
      {% for n, link in m.stars %}<a href="{{ link }}" style="text-decoration:none;font-size:17px;">{{ '★' * n }}{{ '☆' * (5 - n) }}</a>&nbsp; {% endfor %}
    </div>
    <div style="margin-top: 6px; font-size: 13px;">
      <a href="{{ m.keep_url }}" style="color:#c96f4a;">make it a regular</a> ·
      <a href="{{ m.cut_url }}" style="color:#999;">never again</a>
    </div>
    {% endif %}
  </div>
  {% endfor %}

  {% if feedback_url %}
  <p style="margin-top: 22px; font-size: 14px;">
    <a href="{{ feedback_url }}" style="color:#c96f4a;">Add notes or tweak preferences →</a>
  </p>
  {% endif %}
  <p style="font-size: 12px; color: #999; margin-top: 18px;">
    Or just reply to this email — "the curry was too spicy for Cal", "more like
    Tuesday" — replies are read and shape next week's plan.
  </p>
</div>
